<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/stamp" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/stamp" android:fontFamily="monospace" android:paddingBottom="2dp" />
    <TextView android:id="@+id/body" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="300dp" android:padding="10dp" android:textSize="15sp" android:textColor="#202124" android:textIsSelectable="true" />
</LinearLayout>
