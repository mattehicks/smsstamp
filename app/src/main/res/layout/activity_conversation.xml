<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="end|center_vertical" android:weightSum="1">
        <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_weight="0.65" android:layout_height="wrap_content"
            android:hint="Search conversation" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" />
        <Button android:id="@+id/clear" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_weight="0.07" android:layout_height="wrap_content"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="✕" />
        <Button android:id="@+id/prev" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_weight="0.07" android:layout_height="wrap_content"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="▲" />
        <Button android:id="@+id/next" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_weight="0.07" android:layout_height="wrap_content"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="▼" />
        <TextView android:id="@+id/stamps" android:layout_width="0dp" android:layout_weight="0.14" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="12sp" android:textStyle="bold"
            android:text="Stamps" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:textSize="12sp" android:textColor="@color/stamp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
    <LinearLayout android:id="@+id/send_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center_vertical">
        <EditText android:id="@+id/compose" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="Text message" android:inputType="textMultiLine|textCapSentences" android:maxLines="5" />
        <Button android:id="@+id/send" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
